# Copy this file to .env and adjust values for your environment

DATABASE_URL=postgresql+asyncpg://terraiq:terraiq@localhost:5432/terraiq
DATABASE_URL_SYNC=postgresql+psycopg2://terraiq:terraiq@localhost:5432/terraiq
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CORS_ORIGINS=["http://localhost:5173"]

# Set DEBUG=false in production. The app will refuse to start if JWT_SECRET
# is still the default value when DEBUG=false.
DEBUG=true
JWT_SECRET=change-me-in-production-use-a-long-random-string

# Used for password-reset links in emails and docs (no trailing slash)
PUBLIC_APP_URL=http://localhost:5173

# Resend (https://resend.com) — password reset email. Omit to log links only.
# RESEND_API_KEY=re_...
EMAIL_FROM=TerraIQ <onboarding@resend.dev>

# Stripe (optional — pilot billing)
# STRIPE_SECRET_KEY=sk_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PILOT_MONTHLY=price_...

# Deployment / retention (informational + export copy)
# DEPLOYMENT_PROFILE=pilot
# DATA_RETENTION_DAYS=365

# HMAC secret for signing outbound job webhooks (X-TerraIQ-Signature)
WEBHOOK_SIGNING_SECRET=change-me-webhook-signing-secret

# Frontend (Vite) — optional error reporting
# VITE_SENTRY_DSN=https://...@....ingest.sentry.io/...
# VITE_API_URL=http://localhost:8000
