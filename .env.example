# Copy this file to .env and adjust values for your environment

DATABASE_URL=postgresql+asyncpg://terraiq:terraiq@localhost:5432/terraiq
DATABASE_URL_SYNC=postgresql+psycopg2://terraiq:terraiq@localhost:5432/terraiq
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CORS_ORIGINS=["http://localhost:5173"]

# Set DEBUG=false in production. The app will refuse to start if JWT_SECRET
# is still the default value when DEBUG=false.
DEBUG=true
JWT_SECRET=change-me-in-production-use-a-long-random-string
